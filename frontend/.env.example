# Copy to .env.local and edit. Restart `npm run dev` after changing.

# true = built-in fake data (no backend needed). false = call the FastAPI backend.
VITE_USE_MOCK=true

# With the Vite dev proxy (vite.config.js) keep this as /api.
# If the backend is on another origin and has CORS enabled, use e.g. http://localhost:8000/api
VITE_API_BASE=/api

# Demonstration area centre: "lat,lng"  (PLACEHOLDER until you choose your area)
VITE_MAP_CENTER=19.0760,72.8777
